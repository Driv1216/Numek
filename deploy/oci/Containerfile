# syntax=docker/dockerfile:1
# NUMEK ConfidenceGuard operations: one image for the API (with the console), the controller and worker hosts.
# Profile P-SERVER (plan C.2): intended, not qualified. It has not been run on Linux hardware here (M.5, M.3).
#
#   docker build -f deploy/oci/Containerfile -t numek-ops:dev .
#
# - The base image is pinned by digest (python:3.13.17-slim-trixie, published 2026-10-24).
# - Python packages come from constraints/cg7-ops-linux-x86_64-py313.lock with hashes (resolved with
#   --exclude-newer 2026-11-12); the application wheel itself is installed without dependencies.
# - The database is external (NUMEK_DSN, named by the installation's dsn_env); no PostgreSQL runs in this image.
# - Everything persistent (installation.json, objects, secrets, catalogs) lives in /var/lib/numek, owner-only.
ARG PYTHON_IMAGE=python:3.13.17-slim-trixie@sha256:d98cc29d3266e535dd9da1099688d9cb3ca4753813571e071763d17725460962

FROM ${PYTHON_IMAGE} AS build
WORKDIR /src
COPY pyproject.toml setup.py README.md ./
COPY src ./src
RUN python -m pip wheel --no-deps --no-cache-dir -w /wheels .

FROM ${PYTHON_IMAGE}
# WeasyPrint (PDF incident reports) needs Pango, HarfBuzz and fontconfig.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libfontconfig1 fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --user-group --home-dir /var/lib/numek --shell /usr/sbin/nologin numek \
 && install -d -m 0700 -o numek -g numek /var/lib/numek
COPY constraints/cg7-ops-linux-x86_64-py313.lock /tmp/ops.lock
COPY --from=build /wheels /tmp/wheels
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/ops.lock \
 && python -m pip install --no-cache-dir --no-deps /tmp/wheels/*.whl \
 && rm -rf /tmp/wheels /tmp/ops.lock
ENV NUMEK_INSTALLATION=/var/lib/numek \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
USER numek
WORKDIR /var/lib/numek
VOLUME ["/var/lib/numek"]
EXPOSE 8443
STOPSIGNAL SIGTERM
ENTRYPOINT ["confidenceguard", "ops"]
# Serving beyond loopback needs TLS (mount a certificate) or a declared trusted proxy; the serving guard refuses otherwise.
CMD ["serve", "--host", "0.0.0.0", "--port", "8443", "--tls-cert", "/run/numek-tls/tls.crt", "--tls-key", "/run/numek-tls/tls.key"]
