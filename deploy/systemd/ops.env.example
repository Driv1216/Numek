# /etc/numek/ops.env  (owner root:numek, mode 0640 or stricter). Holds the database password: never commit it.
# The installation (created once with `confidenceguard ops init --root /var/lib/numek --dsn-env NUMEK_DSN`)
# records only the variable name NUMEK_DSN, never the connection string.
NUMEK_INSTALLATION=/var/lib/numek
NUMEK_DSN=postgresql://numek:CHANGE-ME@db.internal:5432/numek?sslmode=verify-full
NUMEK_API_HOST=0.0.0.0
NUMEK_API_PORT=8443
NUMEK_API_WORKERS=2
NUMEK_API_THREADS=8
NUMEK_WORKER_LANES=essential,investigation,maintenance
PYTHONDONTWRITEBYTECODE=1
