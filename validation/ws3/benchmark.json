     "expected": {"oracle": "lineage", "titles_absent": ["Changes between before and after were not declared", "Declared transformations are not reflected in the data"]}, "class": "positive"},
    {"id": "ba_filter_no_keys", "family": "german", "kind": "before_after", "op": "ba_filter_drop_impute", "args": {"keys": false}, "target": "credit_risk",
     "transformations": [{"kind": "filter", "description": "credit_amount < 10000"}, {"kind": "drop_columns", "columns": ["telephone"]}, {"kind": "impute", "columns": ["age"]}],
     "expected": {"oracle": "aggregate", "titles": ["Row changes are not explained by identity evidence"]}, "class": "positive"},
    {"id": "ba_dedup", "family": "bank", "kind": "before_after", "op": "ba_dedup", "args": {"rows": 5000, "duplicates": 200}, "target": "subscribed_term_deposit",
     "transformations": [{"kind": "deduplicate", "description": "exact duplicate rows removed"}], "expected": {"oracle": "aggregate"}, "class": "positive"},
    {"id": "ba_undeclared_drop", "family": "german", "kind": "before_after", "op": "ba_drop_column", "args": {"column": "telephone"}, "target": "credit_risk",
     "transformations": [], "expected": {"titles": ["Changes between before and after were not declared"]}, "class": "positive"},
    {"id": "ba_incomplete_impute", "family": "german", "kind": "before_after", "op": "ba_partial_impute", "args": {"column": "age"}, "target": "credit_risk",
     "transformations": [{"kind": "impute", "columns": ["age"]}], "expected": {"titles": ["Declared imputation left missing values"]}, "class": "positive"},
    {"id": "ba_undeclared_encoding", "family": "bank", "kind": "before_after", "op": "ba_one_hot", "args": {"rows": 3000, "column": "housing"}, "target": "subscribed_term_deposit",
     "transformations": [], "expected": {"encodings": ["housing"], "titles": ["Changes between before and after were not declared"]}, "class": "positive"},
    {"id": "ba_declared_not_done", "family": "german", "kind": "before_after", "op": "ba_identity", "args": {}, "target": "credit_risk",
     "transformations": [{"kind": "drop_columns", "columns": ["telephone"]}], "expected": {"titles": ["Declared transformations are not reflected in the data"]}, "class": "positive"}
  ]
}
