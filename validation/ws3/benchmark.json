     "expected": {"codes": ["declared_unavailable_feature"], "columns": ["duration"]}, "class": "positive"},
    {"id": "avail_duration_undeclared", "family": "bank", "kind": "availability", "op": "none", "args": {}, "target": "subscribed_term_deposit",
     "expected": {"absent_codes": ["declared_unavailable_feature", "target_dependency_unavailable"]}, "class": "negative"},
    {"id": "cand_bank", "family": "bank", "kind": "candidates", "op": "none", "args": {}, "target": "subscribed_term_deposit",
