{
  "benchmark": "ws3_context_v1",
  "frozen": "2026-10-20, before any WS3 method was evaluated on these cases",
  "meaning": "Expected outcomes follow from how each case is constructed or from independent pandas facts about the base data; they were fixed before evaluation. Mutations of one base dataset form one family and are not independent samples. Abstentions, unsupported cases and unsearched scope are reported separately and never counted as correct negatives.",
  "bases": {
    "german": "validation/data/prepared/german_credit.csv",
    "adult": "validation/data/prepared/adult.csv",
    "bank": "validation/data/prepared/bank_marketing.csv"
  },
  "cases": [
    {"id": "dep_copy_renamed", "family": "german", "kind": "dependency", "op": "copy_target", "args": {"name": "col_17"}, "target": "credit_risk", "expected": {"flagged": ["col_17"]}, "class": "positive"},
    {"id": "dep_numeric_reencoding", "family": "german", "kind": "dependency", "op": "encode_target", "args": {"name": "flag", "positive": "bad"}, "target": "credit_risk", "expected": {"flagged": ["flag"]}, "class": "positive"},
    {"id": "dep_categorical_proxy", "family": "adult", "kind": "dependency", "op": "proxy_categories", "args": {"name": "segment_code", "splits": 3}, "target": "annual_income_over_50k", "expected": {"flagged": ["segment_code"]}, "class": "positive"},
    {"id": "dep_quantitative_separator", "family": "bank", "kind": "dependency", "op": "separator", "args": {"name": "x_score", "positive": "yes"}, "target": "subscribed_term_deposit", "expected": {"flagged": ["x_score"]}, "class": "positive"},
    {"id": "dep_noisy_copy", "family": "german", "kind": "dependency", "op": "noisy_copy", "args": {"name": "col_noisy", "noise": 0.02}, "target": "credit_risk", "expected": {"flagged": []}, "class": "expected_miss",
     "note": "A true leak the zero-violation gate cannot detect: reported as a miss, by design."},
    {"id": "dep_outcome_like_name", "family": "german", "kind": "dependency", "op": "independent_categories", "args": {"name": "outcome_note"}, "target": "credit_risk", "expected": {"flagged": []}, "class": "negative"},
    {"id": "dep_identifier", "family": "adult", "kind": "dependency", "op": "row_identifier", "args": {"name": "customer_id"}, "target": "annual_income_over_50k", "expected": {"flagged": []}, "class": "negative"},
    {"id": "dep_raw_bank", "family": "bank", "kind": "dependency", "op": "none", "args": {}, "target": "subscribed_term_deposit", "expected": {"flagged": []}, "class": "negative"},
    {"id": "dep_raw_adult", "family": "adult", "kind": "dependency", "op": "none", "args": {}, "target": "annual_income_over_50k", "expected": {"flagged": []}, "class": "negative"},
    {"id": "dep_raw_german", "family": "german", "kind": "dependency", "op": "none", "args": {}, "target": "credit_risk", "expected": {"flagged": []}, "class": "negative"},
    {"id": "dep_small_sample", "family": "german", "kind": "dependency", "op": "head_with_copy", "args": {"rows": 60, "name": "col_17"}, "target": "credit_risk", "expected": {"status": "not_assessable"}, "class": "abstention"},
    {"id": "dep_declared_available", "family": "german", "kind": "availability", "op": "copy_target", "args": {"name": "risk_band"}, "target": "credit_risk",
