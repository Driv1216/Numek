     "expected": {"codes": ["deterministic_predictor_declared_available"], "absent_codes": ["target_dependency_unavailable", "dependency_availability_unknown"]}, "class": "negative"},
    {"id": "dep_declared_unavailable", "family": "german", "kind": "availability", "op": "copy_target", "args": {"name": "decision_flag"}, "target": "credit_risk",
