    {"id": "cand_999_outside", "family": "german", "kind": "candidates", "op": "outside_code", "args": {"name": "months_open", "code": 999, "share": 0.03}, "target": "credit_risk",
     "expected": {"candidates": [["months_open", 999]]}, "class": "positive"},
    {"id": "cand_999_rare", "family": "german", "kind": "candidates", "op": "outside_code", "args": {"name": "months_open", "code": 999, "share": 0.005}, "target": "credit_risk",
     "expected": {"no_candidate_columns": ["months_open"]}, "class": "abstention", "note": "Below the 1% conservative floor: no suggestion by design."},
    {"id": "decl_pdays", "family": "bank", "kind": "declaration", "op": "none", "args": {}, "target": "subscribed_term_deposit",
     "context": {"columns": {"pdays": {"sentinels": [{"value": -1, "meaning": "not_applicable"}], "applies_when": {"column": "previous", "op": ">", "value": 0}}}},
     "expected": {"oracle": "pdays_applicable"}, "class": "positive"},
    {"id": "decl_poutcome", "family": "bank", "kind": "declaration", "op": "none", "args": {}, "target": "subscribed_term_deposit",
